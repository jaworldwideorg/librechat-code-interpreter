# Combined Worker-Sandbox Dockerfile
#
# Supports:
#
#   KVM_ENABLED=true
#     Fedora worker
#       -> libkrun MicroVM
#         -> Debian sandbox rootfs
#           -> NsJail
#
#   KVM_ENABLED=false
#     Fedora worker
#       -> direct sandbox process
#         -> static rootfs setup helper
#           -> Debian userspace and NsJail
#
# Direct mode atomically switches from the Fedora host userspace to the Debian
# sandbox rootfs before starting the Debian-built NsJail.

# ============================================================================
# Stage 1a: Build NsJail for the Debian sandbox rootfs
# ============================================================================
FROM buildpack-deps:bookworm AS nsjail-builder-debian

WORKDIR /nsjail

COPY docker/apt-install.sh /usr/local/bin/apt-install
RUN chmod +x /usr/local/bin/apt-install

RUN apt-install \
    bison \
    flex \
    libprotobuf-dev \
    libnl-route-3-dev \
    protobuf-compiler \
    pkg-config

RUN git clone -b master --single-branch https://github.com/google/nsjail.git . \
    && git checkout 66ad78dc361721512fbf9470488e584364c75489 \
    && git submodule update --init --recursive

RUN make -j$(nproc)

COPY api/src/spec-guard.c /tmp/spec-guard.c
COPY docker/rootfs-setup.c /tmp/rootfs-setup.c
RUN gcc -O2 -static -Wall -Wextra -Werror -o /usr/local/bin/spec-guard /tmp/spec-guard.c \
    && gcc -O2 -static -Wall -Wextra -Werror -o /usr/local/bin/sandbox-rootfs-setup /tmp/rootfs-setup.c \
    && chmod 0111 /usr/local/bin/spec-guard /usr/local/bin/sandbox-rootfs-setup


# ============================================================================
# Stage 1b: Build language runtime packages for the baked KVM root disk
# ============================================================================
FROM buildpack-deps:bookworm AS package-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHON_VERSION=3.14.4
ENV BUN_VERSION=1.3.14

COPY docker/apt-install.sh /usr/local/bin/apt-install
RUN chmod +x /usr/local/bin/apt-install

RUN apt-install \
    curl \
    unzip \
    wget \
    ca-certificates \
    build-essential \
    pkg-config \
    libssl-dev \
    libffi-dev \
    libsqlite3-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libncurses5-dev \
    liblzma-dev \
    libgdbm-dev \
    libnss3-dev \
    uuid-dev \
    libmagic-dev \
    libqpdf-dev \
    tk-dev \
    xz-utils \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libudunits2-dev \
    libpng-dev \
    libxml2-dev \
    libcairo2-dev \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libfreetype6-dev \
    libjpeg-dev \
    libopenjp2-7-dev

RUN mkdir -p /pkgs

COPY docker/package-init.sh /package-init.sh
COPY python-packages.txt /python-packages.txt
COPY javascript-packages.txt /javascript-packages.txt

RUN chmod +x /package-init.sh \
    && FORCE_REBUILD=true /package-init.sh


# ============================================================================
# Stage 2: Build worker
# ============================================================================
FROM oven/bun:1.3.14 AS worker-builder

WORKDIR /app

COPY service/package.json service/bun.lock ./
RUN bun install --frozen-lockfile

COPY service/src ./src
COPY packages/code/src /packages/code/src
COPY shared /shared
COPY service/tsconfig.json ./

RUN bun build ./src/worker-server.ts \
    --minify \
    --outdir .build \
    --target bun \
    --external '@opentelemetry/*'


# ============================================================================
# Stage 3: Build sandbox API
# ============================================================================
FROM oven/bun:1.3.14 AS sandbox-builder

WORKDIR /app

COPY api/package.json ./
RUN bun install --frozen-lockfile

COPY api/src ./src
COPY shared /shared
COPY api/tsconfig.json ./

RUN bun build ./src/index.ts \
    --minify \
    --outdir .build \
    --target bun \
    --external '@opentelemetry/*'


# ============================================================================
# Stage 4: Build Debian sandbox rootfs
# ============================================================================
FROM oven/bun:1.3.14-debian AS sandbox-rootfs

ENV DEBIAN_FRONTEND=noninteractive

COPY docker/apt-install.sh /usr/local/bin/apt-install
RUN chmod +x /usr/local/bin/apt-install

RUN apt-install \
    coreutils \
    util-linux \
    bsdextrautils \
    locales \
    procps \
    iptables \
    bc \
    file \
    libmagic1 \
    jq \
    zip \
    unzip \
    p7zip-full \
    xz-utils \
    tar \
    poppler-utils \
    qpdf \
    ghostscript \
    mupdf-tools \
    fontconfig \
    libfontconfig1 \
    fonts-dejavu \
    fonts-liberation \
    fonts-noto-core \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-noto-extra \
    fonts-noto-mono \
    libharfbuzz0b \
    libfribidi0 \
    librsvg2-bin \
    imagemagick \
    libvips-tools \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    pandoc \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    tesseract-ocr-por \
    tesseract-ocr-ara \
    tesseract-ocr-chi-sim \
    tesseract-ocr-fra \
    tesseract-ocr-hin \
    tesseract-ocr-rus \
    tesseract-ocr-osd \
    sqlite3 \
    libxml2-utils \
    xmlstarlet \
    ripgrep \
    tree \
    diffutils \
    patch \
    uchardet \
    icu-devtools \
    antiword \
    catdoc \
    unrtf \
    libimage-exiftool-perl \
    mediainfo \
    pst-utils \
    djvulibre-bin \
    ffmpeg \
    graphviz \
    libcairo2 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    libssl3 \
    zlib1g \
    libbz2-1.0 \
    libsqlite3-0 \
    liblzma5 \
    libreadline8 \
    libgdbm6 \
    libgdbm-compat4 \
    libncursesw6 \
    libuuid1 \
    libblas3 \
    liblapack3 \
    tk8.6 \
    libnl-route-3-200 \
    libprotobuf32 \
    libffi8 \
    ca-certificates \
    && fc-cache -f \
    && libffi=$(find /usr/lib -name 'libffi.so.8' -print -quit) \
    && { [ -n "$libffi" ] || { echo "libffi.so.8 not found" >&2; exit 1; }; } \
    && ln -sf "$libffi" "${libffi%.so.8}.so.6"

# Restore standard Debian awk -> mawk symlink.
RUN [ -x /usr/bin/mawk ] && ln -sf /usr/bin/mawk /usr/bin/awk

RUN sed -i -E \
        '/^(# )?(en_US|es_ES|pt_BR|ar_SA|zh_CN|fr_FR|hi_IN|ru_RU)(\.UTF-8)? UTF-8$/s/^# //' \
        /etc/locale.gen \
    && locale-gen \
    && for locale_name in en_US es_ES pt_BR ar_SA zh_CN fr_FR hi_IN ru_RU; do \
         locale -a | grep -qi "^${locale_name}\.utf8$" || exit 1; \
       done

# IMPORTANT:
# This rootfs is Debian, therefore use the Debian-built NsJail.
COPY --from=nsjail-builder-debian /nsjail/nsjail /usr/sbin/nsjail
COPY --from=nsjail-builder-debian /usr/local/bin/spec-guard /usr/local/bin/spec-guard

RUN chmod +x /usr/sbin/nsjail

WORKDIR /sandbox_api

COPY api/package.json ./
RUN bun install --frozen-lockfile --production

COPY --from=sandbox-builder /app/.build ./.build
COPY api/config ./config
COPY api/src/entrypoint.sh ./entrypoint.sh

RUN chmod +x ./entrypoint.sh

RUN mkdir -p /pkgs /tmp/sandbox

# Strip setuid/setgid bits.
RUN find / -xdev -perm /6000 -exec chmod ug-s {} + 2>/dev/null || true

# Remove tools that should not be available from inside the sandbox rootfs.
RUN rm -f \
    /usr/bin/nsenter \
    /usr/bin/unshare \
    /usr/bin/chroot \
    /usr/sbin/chroot \
    /usr/bin/apt \
    /usr/bin/apt-get \
    /usr/bin/dpkg \
    /usr/local/bin/apt-install \
    /usr/sbin/adduser \
    /usr/sbin/useradd \
    /usr/sbin/usermod \
    /usr/sbin/groupadd \
    /usr/sbin/groupmod \
    /usr/bin/su \
    /usr/bin/chfn \
    /usr/bin/chsh \
    /usr/bin/gpasswd \
    /usr/bin/newgrp \
    /usr/bin/passwd \
    /usr/bin/sg \
    /usr/bin/chage \
    /usr/bin/expiry \
    /usr/sbin/unix_chkpwd \
    2>/dev/null || true

COPY docker/verify-document-tooling.sh /usr/local/bin/verify-document-tooling
RUN chmod 0555 /usr/local/bin/verify-document-tooling \
    && /usr/local/bin/verify-document-tooling --system


# ============================================================================
# Stage 5: Build Rust launcher binary
# ============================================================================
FROM fedora:43 AS launcher-builder

RUN dnf install -y \
    rust \
    cargo \
    libkrun-devel \
    gcc \
    && dnf clean all

WORKDIR /launcher

COPY launcher/Cargo.toml launcher/build.rs ./
COPY launcher/src/ ./src/

RUN cargo build --release


# ============================================================================
# Stage 5b: Build read-only ext4 guest root disk
# ============================================================================
FROM debian:bookworm AS worker-sandbox-rootfs-image

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        e2fsprogs \
        coreutils \
        gawk \
    && rm -rf /var/lib/apt/lists/*

COPY --from=sandbox-rootfs / /sandbox-rootfs/
COPY --from=package-builder /pkgs /sandbox-rootfs/pkgs
COPY docker/build-rootfs-image.sh /usr/local/bin/build-rootfs-image.sh

RUN sed -i \
    '/^cgroup_mem_swap_max/d' \
    /sandbox-rootfs/sandbox_api/config/sandbox.cfg

RUN chmod +x /usr/local/bin/build-rootfs-image.sh \
    && chroot /sandbox-rootfs /usr/local/bin/verify-document-tooling --python \
    && /usr/local/bin/build-rootfs-image.sh \
        /sandbox-rootfs \
        /sandbox-rootfs.img


# ============================================================================
# Stage 6: Shared worker host
# ============================================================================
FROM fedora:43 AS worker-sandbox-base

RUN dnf install -y --setopt=install_weak_deps=False \
    libkrun \
    socat \
    curl \
    unzip \
    util-linux \
    grep \
    gawk \
    findutils \
    ca-certificates \
    && dnf clean all

# Install Bun for the worker process.
RUN curl -fsSL https://bun.sh/install | bash

ENV PATH="/root/.bun/bin:${PATH}"

# --- Launcher (runs on host, boots microVM) ---
COPY --from=launcher-builder \
    /launcher/target/release/sandbox-launcher \
    /usr/local/bin/launcher
COPY --from=nsjail-builder-debian /usr/local/bin/sandbox-rootfs-setup /sandbox-rootfs-setup

# --- Launcher/direct-mode entrypoints ---
COPY launcher/entrypoint.sh /usr/local/bin/launcher-entrypoint.sh
COPY docker/start-direct-sandbox.sh /usr/local/bin/start-direct-sandbox.sh

RUN chmod +x \
    /usr/local/bin/launcher-entrypoint.sh \
    /usr/local/bin/start-direct-sandbox.sh

# --- Worker ---
WORKDIR /worker

COPY service/package.json service/bun.lock ./
RUN bun install --frozen-lockfile --production

COPY --from=worker-builder /app/.build ./.build
COPY --from=worker-builder /app/src ./src
COPY --from=worker-builder \
    /app/src/matplotlib.py \
    /app/src/matplotlib-async.py \
    ./

# --- Supervisor ---
COPY docker/supervisor.sh /supervisor.sh
RUN chmod +x /supervisor.sh

WORKDIR /

EXPOSE 2000 3113

HEALTHCHECK \
    --interval=30s \
    --timeout=5s \
    --start-period=30s \
    --retries=3 \
    CMD curl -f http://localhost:3113/health || exit 1

CMD ["/supervisor.sh"]


# ============================================================================
# Direct/legacy target
#
# Used by:
#   KVM_ENABLED=false
#
# /host-packages is expected to be populated externally by package-init.
# ============================================================================
FROM worker-sandbox-base AS worker-sandbox-legacy

COPY --from=sandbox-rootfs / /sandbox-rootfs/

RUN sed -i '/^cgroup_mem_swap_max/d' /sandbox-rootfs/sandbox_api/config/sandbox.cfg \
    && mkdir -p /host-packages

# ============================================================================
# KVM baked target
# ============================================================================
FROM worker-sandbox-base AS worker-sandbox-baked

COPY --from=worker-sandbox-rootfs-image \
    /sandbox-rootfs.img \
    /sandbox-rootfs.img

ENV LAUNCHER_ROOT_DISK=/sandbox-rootfs.img \
    LAUNCHER_ROOT_DISK_READ_ONLY=true \
    LAUNCHER_ROOT_DEVICE=/dev/vda \
    LAUNCHER_ROOT_FSTYPE=ext4 \
    LAUNCHER_ROOT_OPTIONS=ro


# ============================================================================
# Compose aliases
# ============================================================================
FROM worker-sandbox-baked AS worker-sandbox-true

FROM worker-sandbox-legacy AS worker-sandbox-false

FROM worker-sandbox-true AS worker-sandbox-default
